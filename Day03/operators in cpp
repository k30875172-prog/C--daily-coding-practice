#include <iostream>
using namespace std;

int main() {
    int a = 10;
    int b = 50;
    cout <<"The value of a + b is "<<a+b<<endl;
    cout <<"The value of a - b is "<<a-b<<endl;
    cout <<"The value of a * b is "<<a*b<<endl;
    cout <<"The value of a / b is "<<a/b<<endl;
    cout <<"The value of a % b is "<<a%b<<endl;
    cout <<"The value of a ++ is "<<a++<<endl;
    cout <<"The value of a -- is "<<a--<<endl;
    cout <<"The value of ++a is "<<++a<<endl;
    cout <<"The value of --a is "<<--a<<endl;
    return 0;    
}
